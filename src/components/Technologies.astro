---
import { Carrousel } from './react/Carrousel'
import techs from '../data/technologies.json'

const categories = ['Frontend', 'Backend', 'Databases', 'Cloud', 'Tools']


---
  <p
  id="techs"
    class='text-center text-4xl movil-lg:text-5xl tablet:text-6xl laptop:text-7xl font-inter font-bold mt-20 mb-10 laptop:mt-28 text-indigo-100'
  >
    Tecnologías
  </p>

  <section class='w-full max-w-6xl px-3 mx-auto'>

    {
      categories.map((category) => (
        <div class='mb-12'>

          <!-- Título de categoría -->
          <h3
            class='text-center text-3xl movil-lg:text-4xl tablet:text-5xl laptop:text-6xl font-inter font-bold text-indigo-100 mb-6'
          >
            {category}
          </h3>

          <!-- Tecnologías de la categoría -->
          <div
            class='grid grid-cols-1 movil-lg:grid-cols-2 tablet:grid-cols-3 gap-5'
          >
            {
              techs
                .filter((tech) => tech.category === category)
                .map((tech) => (
                  <div
                    class='flex items-center justify-evenly flex-wrap w-full max-w-md my-2 p-5 tablet-lg:py-7 laptop:py-8 mx-auto rounded-lg bg-gray-300 cursor-default'
                    title={tech.name}
                  >
                    <img
                      class='max-w-[40px] max-h-[40px] laptop:max-w-[50px] laptop:max-h-[50px]'
                      src={tech.image}
                      alt={tech.name}
                    />

                    <p class='mx-5 font-inter font-semibold text-slate-800'>
                      {tech.name}
                    </p>
                  </div>
                ))
            }
          </div>

        </div>
      ))
    }

  </section>